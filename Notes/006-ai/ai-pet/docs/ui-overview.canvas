{
	"nodes":[
		{"id":"a1b2c3d4e5f60001","type":"group","x":-100,"y":-50,"width":1200,"height":900,"color":"5","label":"手机屏幕"},
		{"id":"a1b2c3d4e5f60003","type":"text","text":"# 🐱 宠物位置\n\n**默认：右下角**\n\n尺寸：屏幕的 1/8\n\n可拖动到任意位置\n\n记住用户偏好的位置","x":800,"y":600,"width":250,"height":180,"color":"6"},
		{"id":"a1b2c3d4e5f60004","type":"text","text":"# 📱 APP 内容区\n\n**不被遮挡**\n\n用户正常使用 APP\n\n宠物在角落陪伴","x":50,"y":300,"width":280,"height":160,"color":"3"},
		{"id":"a1b2c3d4e5f60005","type":"text","text":"# 🔔 通知栏\n\n宠物的心情图标\n\n显示在状态栏","x":50,"y":500,"width":280,"height":120,"color":"2"},
		{"id":"a1b2c3d4e5f60006","type":"text","text":"# 🎯 设计原则\n\n## 1. 不打扰\n宠物在角落，不遮挡内容\n\n## 2. 可感知\n余光能看到它的动作\n\n## 3. 可交互\n点击/长按/滑动都有反应\n\n## 4. 可拖动\n用户决定它在哪里","x":450,"y":0,"width":350,"height":250,"color":"1"},
		{"id":"a1b2c3d4e5f60007","type":"text","text":"# 👁️ 眼神跟随\n\n宠物的眼睛会跟随\n屏幕内容变化\n\n增强\"它在看\"的感觉","x":850,"y":200,"width":220,"height":150,"color":"4"},
		{"id":"a1b2c3d4e5f60008","type":"text","text":"# 🎨 视觉风格\n\n**2D 简约风格**\n- 非写实，卡通可爱\n- 柔和色彩\n- 流畅骨骼动画\n\n**表情丰富**\n- 30+ 基础表情\n- 可组合（开心+困）","x":450,"y":350,"width":300,"height":180,"color":"6"},
		{"id":"a1b2c3d4e5f60002","type":"text","text":"# 📍 主界面布局\n\n宠物始终在屏幕的**角落或边缘**\n\n- 不遮挡主要内容\n- 用户可拖动到任意位置\n- 默认右下角","x":30,"y":50,"width":300,"height":200,"color":"4"}
	],
